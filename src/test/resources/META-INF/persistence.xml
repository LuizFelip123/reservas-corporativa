<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.1">
    <persistence-unit name="reservasTestPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <class>br.com.estudo.reservas.model.Usuario</class>
        <class>br.com.estudo.reservas.model.Recurso</class>
        <class>br.com.estudo.reservas.model.Reserva</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver" />
            <property name="jakarta.persistence.jdbc.user" value="sa" />
            <property name="jakarta.persistence.jdbc.password" value="" />
            <property name="eclipselink.ddl-generation" value="drop-and-create-tables" />
            <property name="eclipselink.ddl-generation.output-mode" value="database" />
            <property name="eclipselink.weaving" value="false" />
            <property name="eclipselink.logging.level" value="SEVERE" />
            <property name="eclipselink.cache.shared.default" value="false" />
        </properties>
    </persistence-unit>
</persistence>